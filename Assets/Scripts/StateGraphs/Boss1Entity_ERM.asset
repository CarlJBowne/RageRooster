      Outputs","body":"If the Attack ID is the same as the AttackOddsRange count
      (the max value of the list), the boss does nothing and loops its pursuit. This
      prevents a value over the list length of possible attacks from passing in.","colorTheme":"Classic","guid":"ff282a68-7dac-4418-b5b0-8b733813e4a6","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":1442.0,"y":194.0},"guid":"6b4ef579-ce3e-4a54-b718-95cae84371c2","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"281"},{"member":{"name":"bossPhase","parameterTypes":null,"targetType":"Boss1Health","targetTypeName":"Boss1Health","$version":"A"},"defaultValues":{"target":null},"position":{"x":1702.0,"y":-141.0},"guid":"5c6abbad-856f-4a45-ba1c-edfd1b9423be","$version":"A","$type":"Unity.VisualScripting.GetMember","$id":"376"},{"member":{"name":"bossPhase","parameterTypes":null,"targetType":"Boss1Health","targetTypeName":"Boss1Health","$version":"A"},"defaultValues":{"target":null},"position":{"x":1016.0,"y":217.0},"guid":"744559c3-7f2b-4120-9a99-c4d99937bbec","$version":"A","$type":"Unity.VisualScripting.GetMember","$id":"379"},{"member":{"name":"Position","parameterTypes":null,"targetType":"RageRooster.Player.Player","targetTypeName":"RageRooster.Player.Player","$version":"A"},"defaultValues":{},"position":{"x":1440.0,"y":56.0},"guid":"d35a27ba-759a-42a6-8b8b-31f2e218dd40","$version":"A","$type":"Unity.VisualScripting.GetMember","$id":"382"},{"chainable":false,"parameterNames":["message"],"member":{"name":"Log","parameterTypes":["System.Object"],"targetType":"UnityEngine.Debug","targetTypeName":"UnityEngine.Debug","$version":"A"},"defaultValues":{},"position":{"x":1735.0,"y":179.0},"guid":"c4755728-8e55-44da-9aa3-c2ada93e4875","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"385"},{"kind":"Object","defaultValues":{"name":{"$content":"ForcedRangeChange","$type":"System.String"},"object":null},"position":{"x":2208.0,"y":208.0},"guid":"3a74bfa3-67cb-4f38-9b96-fa31c8c9b793","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"389"},{"defaultValues":{},"position":{"x":-21.0,"y":-2